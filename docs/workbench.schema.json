{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Blizz127/workbench/main/docs/workbench.schema.json",
  "title": "Workbench project metadata",
  "description": "Portable project metadata consumed by the Workbench Development Lab.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "type": "integer", "const": 1, "default": 1 },
    "name": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "repositoryPath": { "type": ["string", "null"] },
    "buildCommand": { "type": ["string", "null"] },
    "runCommand": { "type": ["string", "null"] },
    "testCommand": { "type": ["string", "null"] },
    "matchingBuildCommand": { "type": ["string", "null"] },
    "composeFile": {
      "type": ["string", "null"],
      "description": "Explicit compose file for Docker operations (relative to the repository root or absolute). Null/omitted means auto-detect conventional names."
    },
    "tmuxSession": {
      "type": ["string", "null"],
      "description": "Explicit tmux session name for this project (letters, digits, '_' and '-'). Null/omitted means a slug is synthesized from the project name."
    },
    "documentationPaths": { "type": "array", "items": { "type": "string" }, "default": [] },
    "aiContextPaths": { "type": "array", "items": { "type": "string" }, "default": [] },
    "preferredAiProvider": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "promptRules": { "type": ["string", "null"] },
    "customLogPatterns": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pattern"],
        "properties": {
          "name": { "type": "string" },
          "pattern": { "type": "string" },
          "isRegex": { "type": "boolean", "default": false },
          "category": { "type": "string", "default": "General" }
        }
      }
    },
    "launchProfile": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "startupGraceSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "statusCommand": { "type": ["string", "null"] },
        "requiredServices": { "type": "array", "items": { "type": "string" }, "default": [] },
        "optionalServices": { "type": "array", "items": { "type": "string" }, "default": [] },
        "healthyPatterns": { "type": "array", "items": { "type": "string" }, "default": [] },
        "failedPatterns": { "type": "array", "items": { "type": "string" }, "default": [] },
        "serviceLogCommand": { "type": ["string", "null"] },
        "healthCheckRetries": { "type": ["integer", "null"], "minimum": 0 },
        "healthCheckIntervalSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "stopCommand": { "type": ["string", "null"] },
        "logsCommand": { "type": ["string", "null"] },
        "updateCommand": { "type": ["string", "null"] },
        "metricsCommand": { "type": ["string", "null"] }
      }
    },
    "mobileActions": {
      "type": "array",
      "default": [],
      "description": "Allowlist of actions the mobile web dashboard may run for this project. Anything not listed here cannot be triggered from a phone; unknown types fail closed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier used in URLs and the action journal."
          },
          "label": {
            "type": "string",
            "description": "Button label on the phone."
          },
          "type": {
            "type": "string",
            "enum": [
              "dockerLogsAll",
              "dockerLogsService",
              "dockerRestartService",
              "dockerRestartAllowed",
              "tmuxCreateSession",
              "predefinedCommand"
            ]
          },
          "service": {
            "type": ["string", "null"],
            "description": "Compose service name for dockerLogsService / dockerRestartService."
          },
          "commandId": {
            "type": ["string", "null"],
            "enum": ["build", "test", "launch", null],
            "description": "Command selector for predefinedCommand, mapping to the project's buildCommand / testCommand / runCommand."
          },
          "safety": {
            "type": ["string", "null"],
            "enum": ["readOnly", "requiresConfirmation", "requiresDoubleConfirmation", null],
            "description": "Safety override; may only RAISE the type's default level, never lower it. Defaults: log viewers readOnly; restarts and launch requiresDoubleConfirmation; tmuxCreateSession, build and test requiresConfirmation."
          },
          "allowDatabase": {
            "type": "boolean",
            "default": false,
            "description": "Permits restarting database-like services (database, db, mysql, mariadb, postgres, postgresql, mongo, mongodb, redis — exact or prefix match). Refused without this explicit opt-in."
          }
        }
      }
    }
  }
}
