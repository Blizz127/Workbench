<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Theme-variant brushes. Everything theme-dependent lives here; views and
        styles reference these via {DynamicResource} so a theme switch applies
        without rebuilding the visual tree.

        Dark: cool neutral grays (KDE Breeze-dark / GNOME-dark family), never pure black.
        Light: designed, not inverted — muted text stays >= ~4.5:1 on white, badge
        tints remain visible on light surfaces.

        The output panel is intentionally dark in BOTH themes (terminal convention);
        its text brush is always the light OutputPanelTextBrush.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Surfaces -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1A1D21" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#22262C" />
            <SolidColorBrush x:Key="CardRaisedBackgroundBrush" Color="#282D34" />
            <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#14171B" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#31363E" />
            <SolidColorBrush x:Key="DividerBrush" Color="#262B31" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F014161A" />
            <SolidColorBrush x:Key="OverlayBorderBrush" Color="#3DFFFFFF" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4E7EB" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB1BA" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8B929C" />

            <!-- Accent (restrained technical blue) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#4C82C7" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#5E92D3" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#3E71B4" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FocusBrush" Color="#4C82C7" />

            <!-- Status -->
            <SolidColorBrush x:Key="StatusActiveBrush" Color="#3FA060" />
            <SolidColorBrush x:Key="StatusWaitingBrush" Color="#C29A3C" />
            <SolidColorBrush x:Key="StatusBrokenBrush" Color="#D96A5F" />
            <SolidColorBrush x:Key="StatusResearchBrush" Color="#5D97D1" />
            <SolidColorBrush x:Key="StatusCompleteBrush" Color="#78808A" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A" />
            <!-- Danger/Info are lightened enough to stay >= 4.5:1 on their tinted badge backgrounds -->
            <SolidColorBrush x:Key="DangerBrush" Color="#F59180" />
            <SolidColorBrush x:Key="WarningBrush" Color="#E0B34E" />
            <SolidColorBrush x:Key="InfoBrush" Color="#8FBCE4" />
            <SolidColorBrush x:Key="NeutralBrush" Color="#8B929C" />

            <!-- Subtle tinted backgrounds for badges/banners (alpha over surface) -->
            <SolidColorBrush x:Key="SuccessTintBrush" Color="#2E4CC38A" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="#2EF16A50" />
            <SolidColorBrush x:Key="WarningTintBrush" Color="#2EE0B34E" />
            <SolidColorBrush x:Key="InfoTintBrush" Color="#2E5D97D1" />
            <SolidColorBrush x:Key="NeutralTintBrush" Color="#22FFFFFF" />

            <!-- Terminal-style output: dark in both themes -->
            <SolidColorBrush x:Key="OutputPanelBackgroundBrush" Color="#14171B" />
            <SolidColorBrush x:Key="OutputPanelTextBrush" Color="#D5DBE1" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Surfaces -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F3F5" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardRaisedBackgroundBrush" Color="#EDEFF2" />
            <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#E7E9EC" />
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#D4D8DD" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E3E6E9" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F0FFFFFF" />
            <SolidColorBrush x:Key="OverlayBorderBrush" Color="#33000000" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B2129" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#47505A" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#5D6771" />

            <!-- Accent (deeper for contrast on light surfaces) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#2F6BB3" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#2A5FA0" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#265391" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FocusBrush" Color="#2F6BB3" />

            <!-- Status -->
            <SolidColorBrush x:Key="StatusActiveBrush" Color="#1E7B3F" />
            <SolidColorBrush x:Key="StatusWaitingBrush" Color="#8A6D1A" />
            <SolidColorBrush x:Key="StatusBrokenBrush" Color="#B3362E" />
            <SolidColorBrush x:Key="StatusResearchBrush" Color="#2C5F8A" />
            <SolidColorBrush x:Key="StatusCompleteBrush" Color="#5A616A" />
            <!-- Success/Warning are deepened to stay >= 4.5:1 on white and on their tinted badge backgrounds -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#146B45" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C23B2E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#7E6317" />
            <SolidColorBrush x:Key="InfoBrush" Color="#2C5F8A" />
            <SolidColorBrush x:Key="NeutralBrush" Color="#5D6771" />

            <!-- Subtle tinted backgrounds for badges/banners (alpha over surface) -->
            <SolidColorBrush x:Key="SuccessTintBrush" Color="#241F8A5B" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="#24C23B2E" />
            <SolidColorBrush x:Key="WarningTintBrush" Color="#248A6D1A" />
            <SolidColorBrush x:Key="InfoTintBrush" Color="#242C5F8A" />
            <SolidColorBrush x:Key="NeutralTintBrush" Color="#14000000" />

            <!-- Terminal-style output: dark in both themes -->
            <SolidColorBrush x:Key="OutputPanelBackgroundBrush" Color="#14171B" />
            <SolidColorBrush x:Key="OutputPanelTextBrush" Color="#D5DBE1" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
