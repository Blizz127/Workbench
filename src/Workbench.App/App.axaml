<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Workbench.App"
             x:Class="Workbench.App.App">
    <!-- RequestedThemeVariant is set from AppSettings in App.axaml.cs. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Workbench.App/Styles/Tokens.axaml" />
                <ResourceInclude Source="avares://Workbench.App/Styles/Colors.axaml" />
                <ResourceInclude Source="avares://Workbench.App/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Workbench.App/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
