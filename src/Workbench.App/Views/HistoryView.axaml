<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             xmlns:conv="using:Workbench.App.Converters"
             x:Class="Workbench.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <DockPanel Margin="0,8,0,0">
        <!-- Run controls -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="▶ Build" Command="{Binding RunBuildCommand}" />
                    <Button Content="▶ Run" Command="{Binding RunRunCommand}" />
                    <Button Content="▶ Test" Command="{Binding RunTestsCommand}" />
                    <ItemsControl ItemsSource="{Binding AvailableCommands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommandButtonViewModel">
                                <Button Content="{Binding Name, StringFormat='▶ {0}'}" Command="{Binding RunCommand}"
                                        IsEnabled="{Binding !IsRunning}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="■ Cancel" Command="{Binding CancelRunCommand}"
                            IsVisible="{Binding IsRunning}" Background="#9E3A38" />
                    <TextBlock Text="{Binding RunStatus}" VerticalAlignment="Center" Classes="muted" />
                </StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Custom command:" VerticalAlignment="Center"
                               Classes="muted" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Content="+ Add" Command="{Binding AddCustomCommandCommand}"
                            Margin="8,0,0,0" />
                    <TextBox DockPanel.Dock="Left" Width="140" Watermark="name"
                             Text="{Binding NewCommandName}" Margin="0,0,8,0" />
                    <TextBox Watermark="command to run" Text="{Binding NewCommandText}" />
                </DockPanel>
                <TextBlock Text="Commands are configured here or in Settings. History is append-only."
                           Classes="muted" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,12,*" RowDefinitions="240,12,160,12,*">
            <!-- Build history -->
            <Border Grid.Row="0" Grid.Column="0" Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Build / run history" Classes="h2" />
                    <ListBox ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BuildRecordViewModel">
                                <Grid ColumnDefinitions="Auto,8,Auto,8,*,8,Auto,8,Auto" Margin="0,1">
                                    <TextBlock Grid.Column="0" Text="{Binding StartedAt}" Classes="mono muted" />
                                    <Border Grid.Column="2" Classes="chip">
                                        <TextBlock Text="{Binding Kind}" FontSize="10" />
                                    </Border>
                                    <TextBlock Grid.Column="4" Text="{Binding Command}" Classes="mono"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6" Text="{Binding Duration}" Classes="muted" />
                                    <TextBlock Grid.Column="8" Text="{Binding Outcome}" FontWeight="SemiBold"
                                               Foreground="{Binding Succeeded, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Test history -->
            <Border Grid.Row="0" Grid.Column="2" Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Test history" Classes="h2" />
                    <ListBox ItemsSource="{Binding Tests}" SelectedItem="{Binding SelectedTest}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TestRecordViewModel">
                                <StackPanel Margin="0,1" Spacing="2">
                                    <Grid ColumnDefinitions="Auto,8,*,8,Auto,8,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding StartedAt}" Classes="mono muted" />
                                        <TextBlock Grid.Column="2" Text="{Binding Command}" Classes="mono"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding Duration}" Classes="muted" />
                                        <TextBlock Grid.Column="6" Text="{Binding Result}" FontWeight="SemiBold"
                                                   Foreground="{Binding Passed, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Notes}" Classes="muted" FontSize="11"
                                               IsVisible="{Binding Notes.Length}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Named command runs (matching-build + custom) -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Matching-build &amp; custom command history" Classes="h2" />
                    <TextBlock DockPanel.Dock="Top" Classes="muted"
                               Text="No matching-build or custom commands configured yet."
                               IsVisible="{Binding !NamedCommandRuns.Count}" />
                    <ListBox ItemsSource="{Binding NamedCommandRuns}" SelectedItem="{Binding SelectedCommandRun}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommandRunViewModel">
                                <Grid ColumnDefinitions="Auto,8,Auto,8,*,8,Auto,8,Auto,8,Auto" Margin="0,1">
                                    <TextBlock Grid.Column="0" Text="{Binding StartedAt}" Classes="mono muted" />
                                    <Border Grid.Column="2" Classes="chip">
                                        <TextBlock Text="{Binding Name}" FontSize="10" />
                                    </Border>
                                    <TextBlock Grid.Column="4" Text="{Binding Command}" Classes="mono"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6" Text="{Binding Duration}" Classes="muted" />
                                    <TextBlock Grid.Column="8" Text="regression" FontSize="10" Foreground="#F16A50"
                                               IsVisible="{Binding RegressionDetected}" />
                                    <TextBlock Grid.Column="10" Text="{Binding Outcome}" FontWeight="SemiBold"
                                               Foreground="{Binding Succeeded, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Output log + findings -->
            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="*,12,320">
                <Border Grid.Column="0" Classes="card">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Output log" Classes="h2" />
                        <TextBox Text="{Binding SelectedLog}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Log findings" Classes="h2" />
                        <TextBlock DockPanel.Dock="Top" Classes="muted"
                                   Text="No known failure signatures found."
                                   IsVisible="{Binding !LogFindings.Count}" />
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding LogFindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LogFindingViewModel">
                                        <StackPanel Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Classes="chip">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" />
                                                </Border>
                                                <TextBlock Text="{Binding PatternName}" FontSize="11" Classes="muted" />
                                                <TextBlock Text="{Binding LineNumber, StringFormat='line {0}'}"
                                                           FontSize="11" Classes="muted" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding LineText}" Classes="mono" FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
