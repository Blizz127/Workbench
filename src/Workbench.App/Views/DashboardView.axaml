<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             xmlns:conv="using:Workbench.App.Converters"
             x:Class="Workbench.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <DockPanel Margin="{StaticResource Space6All}">

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource Space3}">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Spacing="{StaticResource Space3}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}"
                                VerticalAlignment="Center">
                        <Button Content="Comfortable" Classes="command.ghost" Classes.selected="{Binding !IsCompact}"
                                Command="{Binding SetDensityCommand}" CommandParameter="comfortable"
                                AutomationProperties.Name="Comfortable density" />
                        <Button Content="Compact" Classes="command.ghost" Classes.selected="{Binding IsCompact}"
                                Command="{Binding SetDensityCommand}" CommandParameter="compact"
                                AutomationProperties.Name="Compact density" />
                    </StackPanel>
                    <Button Content="+ Add project" Classes="command" Command="{Binding ToggleAddPanelCommand}" />
                    <Button Content="Rescan" Classes="command" Command="{Binding RescanCommand}"
                            ToolTip.Tip="Re-scan the discovery folder for new projects" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}" VerticalAlignment="Center">
                    <TextBlock Text="Development Lab" Classes="h1" />
                    <TextBlock Text="{Binding SummaryText}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="CPU" Classes="muted" />
                        <TextBlock Text="{Binding CpuText}" Classes="h2 mono" />
                        <ProgressBar Classes="thin" Value="{Binding CpuPercent}" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="RAM" Classes="muted" />
                        <TextBlock Text="{Binding MemoryText}" Classes="h2 mono" />
                        <ProgressBar Classes="thin" Value="{Binding MemoryPercent}" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="Disk" Classes="muted" />
                        <TextBlock Text="{Binding DiskText}" Classes="h2 mono" />
                        <ProgressBar Classes="thin" Value="{Binding DiskPercent}" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="Uptime" Classes="muted" />
                        <TextBlock Text="{Binding UptimeText}" Classes="h2 mono" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" VerticalAlignment="Center">
                <TextBlock Text="Status" Classes="muted" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedFilter}"
                          Width="{StaticResource FilterComboWidth}" />
                <TextBlock Text="Tag" Classes="muted" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding TagFilters}" SelectedItem="{Binding SelectedTag}"
                          Width="{StaticResource FilterComboWidthWide}" />
                <TextBlock Text="Availability" Classes="muted" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AvailabilityFilters}" SelectedItem="{Binding SelectedAvailability}"
                          Width="{StaticResource FilterComboWidthWide}" />
                <TextBlock Text="Sort" Classes="muted" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          Width="{StaticResource FilterComboWidth}" />
            </StackPanel>
        </StackPanel>

        <!-- Add project panel -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="{StaticResource Space3Top}"
                IsVisible="{Binding IsAddPanelOpen}">
            <StackPanel Spacing="{StaticResource Space3}">
                <TextBlock Text="Register a project" Classes="h2" />
                <Grid ColumnDefinitions="*,12,*,12,Auto">
                    <TextBox Grid.Column="0" Watermark="Project name"
                             Text="{Binding NewProjectName}" />
                    <TextBox Grid.Column="2" Watermark="Repository path (optional)"
                             Text="{Binding NewRepositoryPath}" />
                    <Button Grid.Column="4" Content="Add" Classes="command" Command="{Binding AddProjectCommand}" />
                </Grid>
                <TextBlock Text="{Binding AddProjectError}" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding AddProjectError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="muted"
                           Text="If the repository contains a workbench.json, its configuration is imported automatically." />
            </StackPanel>
        </Border>

        <!-- Empty state -->
        <Border DockPanel.Dock="Top" Classes="empty-state" Margin="{StaticResource Space5Top}"
                IsVisible="{Binding !Cards.Count}">
            <TextBlock Classes="empty-state" Text="No projects match the current filters." />
        </Border>

        <!-- Project cards -->
        <ScrollViewer Margin="{StaticResource Space5Top}">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectCardViewModel">
                        <Border Classes="card project-card" Classes.compact="{Binding IsCompact}"
                                Margin="{StaticResource CardMargin}">
                            <StackPanel Classes="card-body">

                                <!-- Header: accent tile, name (opens the project), badges -->
                                <Grid ColumnDefinitions="Auto,8,*">
                                    <Border Grid.Column="0" Classes="card-accent"
                                            Background="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    Spacing="{StaticResource Space1}" VerticalAlignment="Center">
                                            <Border Classes="badge" Classes.warning="{Binding IsSharedBadgeWarning}"
                                                    IsVisible="{Binding HasSharedBadge}"
                                                    ToolTip.Tip="Shared-state sync status">
                                                <TextBlock Text="{Binding SharedBadge}" />
                                            </Border>
                                            <Border Classes="badge"
                                                    Classes.success="{Binding StatusIsSuccess}"
                                                    Classes.warning="{Binding StatusIsWarning}"
                                                    Classes.danger="{Binding StatusIsDanger}"
                                                    Classes.info="{Binding StatusIsInfo}">
                                                <TextBlock Text="{Binding Status}" />
                                            </Border>
                                        </StackPanel>
                                        <Button Classes="card-open" Command="{Binding OpenCommand}"
                                                ToolTip.Tip="{Binding Name}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <TextBlock Classes="card-title" Text="{Binding Name}" />
                                        </Button>
                                    </DockPanel>
                                </Grid>

                                <!-- Alerts -->
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}"
                                            IsVisible="{Binding HasAlerts}">
                                    <Border Classes="badge warning" IsVisible="{Binding IsUnavailable}">
                                        <TextBlock Text="repo missing on this machine" />
                                    </Border>
                                    <Border Classes="badge danger" IsVisible="{Binding HasBlockers}">
                                        <TextBlock Text="{Binding BlockerText}" />
                                    </Border>
                                </StackPanel>

                                <!-- Frontier (comfortable only) -->
                                <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding !IsCompact}">
                                    <TextBlock Grid.Column="0" Text="frontier" Classes="muted" />
                                    <TextBlock Grid.Column="2" Text="{Binding FrontierText}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FrontierText}" />
                                </Grid>

                                <!-- Git -->
                                <Grid ColumnDefinitions="Auto,8,*">
                                    <TextBlock Grid.Column="0" Text="git" Classes="muted" />
                                    <TextBlock Grid.Column="2" Text="{Binding GitText}" Classes="mono"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- Docker (comfortable only, once probed) -->
                                <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding ShowDocker}">
                                    <TextBlock Grid.Column="0" Text="docker" Classes="muted" />
                                    <TextBlock Grid.Column="2" Text="{Binding DockerText}" Classes="mono"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding DockerOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                </Grid>

                                <!-- Milestone progress -->
                                <Grid ColumnDefinitions="60,8,*,8,Auto" IsVisible="{Binding HasMilestones}">
                                    <TextBlock Grid.Column="0" Text="progress" Classes="muted"
                                               VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="2" Classes="thin" Value="{Binding MilestoneProgress}"
                                                 Maximum="100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding MilestoneText}"
                                               Classes="muted" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsCompact}" />
                                </Grid>

                                <!-- Latest results -->
                                <Grid ColumnDefinitions="Auto,8,*">
                                    <TextBlock Grid.Column="0" Text="results" Classes="muted" />
                                    <WrapPanel Grid.Column="2">
                                        <TextBlock Text="{Binding LastBuildText, StringFormat='build {0}'}"
                                                   Margin="{StaticResource Space3Right}" VerticalAlignment="Center"
                                                   Foreground="{Binding BuildOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                        <TextBlock Text="{Binding LastTestText, StringFormat='test {0}'}"
                                                   Margin="{StaticResource Space3Right}" VerticalAlignment="Center"
                                                   Foreground="{Binding TestOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                        <TextBlock Text="{Binding LastRunText, StringFormat='run {0}'}"
                                                   VerticalAlignment="Center" IsVisible="{Binding HasRun}"
                                                   Foreground="{Binding RunOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                    </WrapPanel>
                                </Grid>

                                <!-- Shared sync timestamps (comfortable only, when shared) -->
                                <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding ShowSharedSync}">
                                    <TextBlock Grid.Column="0" Text="shared" Classes="muted" />
                                    <TextBlock Grid.Column="2" Text="{Binding SharedSyncText}" Classes="muted"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- Active task (comfortable only) -->
                                <TextBlock Text="{Binding ActiveTask}" TextWrapping="Wrap" MaxLines="2"
                                           IsVisible="{Binding !IsCompact}" />

                                <!-- Footer: tags, last-updated, Start -->
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Classes="command" Content="▶ Start"
                                            Command="{Binding OpenCommand}" IsVisible="{Binding CanStart}"
                                            ToolTip.Tip="Open the workspace — run it from the Builds &amp; Tests tab"
                                            AutomationProperties.Name="Start project" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastUpdated}" Classes="muted"
                                               VerticalAlignment="Center" Margin="{StaticResource Space3Right}"
                                               IsVisible="{Binding !IsCompact}" />
                                    <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding !IsCompact}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Classes="chip" Margin="{StaticResource ChipMargin}">
                                                    <TextBlock Text="{Binding}" FontSize="{StaticResource FontSizeMicro}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
