<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             xmlns:views="using:Workbench.App.Views"
             xmlns:conv="using:Workbench.App.Converters"
             x:Class="Workbench.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <DockPanel Margin="{StaticResource Space6All}">

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Spacing="{StaticResource Space3}">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Spacing="{StaticResource Space3}" VerticalAlignment="Center">
                    <Button Content="+ Add project" Classes="command" Command="{Binding ToggleAddPanelCommand}" />
                    <Button Content="Rescan" Classes="command" Command="{Binding RescanCommand}"
                            ToolTip.Tip="Re-scan the discovery folder for new projects" />
                </StackPanel>
                <TextBlock Text="Development Lab" Classes="h1" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Fleet summary bar: compact text+count badges, never color alone -->
            <WrapPanel>
                <Border Classes="badge" Margin="{StaticResource ChipMargin}">
                    <TextBlock Text="{Binding Summary.TotalProjects, StringFormat='{}{0} projects'}" />
                </Border>
                <Border Classes="badge success" Margin="{StaticResource ChipMargin}">
                    <TextBlock Text="{Binding Summary.HealthyCount, StringFormat='{}{0} healthy'}" />
                </Border>
                <Border Classes="badge" Classes.warning="{Binding HasAttention}" Margin="{StaticResource ChipMargin}">
                    <TextBlock Text="{Binding Summary.AttentionCount, StringFormat='{}{0} attention'}" />
                </Border>
                <Border Classes="badge" Classes.danger="{Binding HasBlocked}" Margin="{StaticResource ChipMargin}">
                    <TextBlock Text="{Binding Summary.BlockedCount, StringFormat='{}{0} blocked'}" />
                </Border>
                <Border Classes="badge" Classes.danger="{Binding HasFailing}" Margin="{StaticResource ChipMargin}">
                    <TextBlock Text="{Binding Summary.FailingCount, StringFormat='{}{0} failing'}" />
                </Border>
                <Border Classes="badge" Classes.danger="{Binding HasUnavailable}" Margin="{StaticResource ChipMargin}">
                    <TextBlock Text="{Binding Summary.UnavailableCount, StringFormat='{}{0} unavailable'}" />
                </Border>
                <Border Classes="badge" Classes.warning="{Binding HasActiveBlockers}" Margin="{StaticResource ChipMargin}"
                        ToolTip.Tip="Active blockers across all projects">
                    <TextBlock Text="{Binding Summary.ActiveBlockerCount, StringFormat='{}{0} blockers'}" />
                </Border>
                <Border Classes="badge" Margin="{StaticResource ChipMargin}"
                        ToolTip.Tip="Projects whose runtime is healthy or degraded">
                    <TextBlock Text="{Binding Summary.RunningServices, StringFormat='{}{0} running'}" />
                </Border>
                <Border Classes="badge" Classes.danger="{Binding HasFailingServices}" Margin="{StaticResource ChipMargin}"
                        ToolTip.Tip="Projects whose latest runtime health check failed">
                    <TextBlock Text="{Binding Summary.FailingServices, StringFormat='{}{0} failing services'}" />
                </Border>
                <Border Classes="badge" Classes.warning="{Binding HasDirty}" Margin="{StaticResource ChipMargin}"
                        ToolTip.Tip="Projects with uncommitted changes">
                    <TextBlock Text="{Binding Summary.DirtyProjects, StringFormat='{}{0} dirty'}" />
                </Border>
            </WrapPanel>

            <!-- Host metrics -->
            <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="CPU" Classes="muted" />
                        <TextBlock Text="{Binding CpuText}" Classes="h2 mono" />
                        <ProgressBar Classes="thin" Value="{Binding CpuPercent}" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="RAM" Classes="muted" />
                        <TextBlock Text="{Binding MemoryText}" Classes="h2 mono" />
                        <ProgressBar Classes="thin" Value="{Binding MemoryPercent}" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="Disk" Classes="muted" />
                        <TextBlock Text="{Binding DiskText}" Classes="h2 mono" />
                        <ProgressBar Classes="thin" Value="{Binding DiskPercent}" Maximum="100" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="Uptime" Classes="muted" />
                        <TextBlock Text="{Binding UptimeText}" Classes="h2 mono" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Filter chips + sort -->
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Spacing="{StaticResource Space2}" VerticalAlignment="Center">
                    <TextBlock Text="Sort" Classes="muted" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                              Width="{StaticResource FilterComboWidthWide}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding FilterChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardFilterChipViewModel">
                            <Button Content="{Binding Label}" Classes="command.ghost"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding SelectCommand}"
                                    Margin="{StaticResource Space3Right}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </StackPanel>

        <!-- Development Sessions (tmux): read-only inspection plus explicit, confirmed actions -->
        <views:TmuxSessionsView DockPanel.Dock="Top" DataContext="{Binding TmuxSessions}" />

        <!-- Add project panel -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="{StaticResource Space3Top}"
                IsVisible="{Binding IsAddPanelOpen}">
            <StackPanel Spacing="{StaticResource Space3}">
                <TextBlock Text="Register a project" Classes="h2" />
                <Grid ColumnDefinitions="*,12,*,12,Auto">
                    <TextBox Grid.Column="0" Watermark="Project name"
                             Text="{Binding NewProjectName}" />
                    <TextBox Grid.Column="2" Watermark="Repository path (optional)"
                             Text="{Binding NewRepositoryPath}" />
                    <Button Grid.Column="4" Content="Add" Classes="command" Command="{Binding AddProjectCommand}" />
                </Grid>
                <TextBlock Text="{Binding AddProjectError}" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding AddProjectError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="muted"
                           Text="If the repository contains a workbench.json, its configuration is imported automatically." />
            </StackPanel>
        </Border>

        <!-- Recent activity: merged timeline + mobile-action stream -->
        <Border DockPanel.Dock="Right" Classes="card" Width="{StaticResource ActivityPanelWidth}"
                Margin="{StaticResource Space5Left}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Recent Activity" Classes="h2" />
                <TextBlock DockPanel.Dock="Top" Text="No recent activity yet." Classes="muted"
                           IsVisible="{Binding !HasRecentActivity}" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DashboardActivityItemViewModel">
                                <Button Classes="card-open" Command="{Binding OpenCommand}"
                                        ToolTip.Tip="Open the project">
                                    <StackPanel Spacing="{StaticResource Space0}" Margin="{StaticResource Space1Bottom}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                                            <TextBlock Text="{Binding WhenText}" Classes="muted mono" />
                                            <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}" Classes="muted" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="{StaticResource FontSizeSmall}"
                                                   TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Project cards -->
        <Grid Margin="{StaticResource Space5Top}">
            <Border Classes="empty-state" IsVisible="{Binding !Cards.Count}">
                <TextBlock Classes="empty-state" Text="No projects match the current filters." />
            </Border>
            <ScrollViewer IsVisible="{Binding !!Cards.Count}">
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectCardViewModel">
                            <Border Classes="card project-card" Margin="{StaticResource CardMargin}">
                                <StackPanel Classes="card-body">

                                    <!-- Header: accent tile, name (opens the project), health + status badges -->
                                    <Grid ColumnDefinitions="Auto,8,*">
                                        <Border Grid.Column="0" Classes="card-accent"
                                                Background="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}">
                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        Spacing="{StaticResource Space1}" VerticalAlignment="Center">
                                                <Border Classes="badge"
                                                        Classes.success="{Binding HealthIsSuccess}"
                                                        Classes.warning="{Binding HealthIsWarning}"
                                                        Classes.danger="{Binding HealthIsDanger}"
                                                        ToolTip.Tip="{Binding HealthReasonsText}">
                                                    <TextBlock Text="{Binding HealthText}" />
                                                </Border>
                                                <Border Classes="badge">
                                                    <TextBlock Text="{Binding Status}" />
                                                </Border>
                                            </StackPanel>
                                            <Button Classes="card-open" Command="{Binding OpenCommand}"
                                                    ToolTip.Tip="{Binding Name}"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <TextBlock Classes="card-title" Text="{Binding Name}" />
                                            </Button>
                                        </DockPanel>
                                    </Grid>

                                    <!-- Repository availability -->
                                    <Border Classes="badge danger" IsVisible="{Binding IsUnavailable}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="repo missing on this machine" />
                                    </Border>

                                    <!-- Frontier -->
                                    <Grid ColumnDefinitions="60,8,*">
                                        <TextBlock Grid.Column="0" Text="frontier" Classes="muted" />
                                        <TextBlock Grid.Column="2" Text="{Binding FrontierText}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FrontierText}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,8,*" IsVisible="{Binding HasFrontier}">
                                        <TextBlock Grid.Column="0" Text="checklist" Classes="muted" />
                                        <TextBlock Grid.Column="2" Text="{Binding FrontierCountText}" Classes="muted" />
                                    </Grid>

                                    <!-- Next safest step -->
                                    <Grid ColumnDefinitions="60,8,*">
                                        <TextBlock Grid.Column="0" Text="next" Classes="muted" />
                                        <TextBlock Grid.Column="2" Text="{Binding NextStepText}"
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NextStepText}" />
                                    </Grid>

                                    <!-- Milestone progress (null projection = not configured, never 0%) -->
                                    <Grid ColumnDefinitions="60,8,*,8,Auto" IsVisible="{Binding HasProgress}">
                                        <TextBlock Grid.Column="0" Text="progress" Classes="muted"
                                                   VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="2" Classes="thin" Value="{Binding ProgressPercent}"
                                                     Maximum="100" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding ProgressText}"
                                                   Classes="muted" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="60,8,*" IsVisible="{Binding !HasProgress}">
                                        <TextBlock Grid.Column="0" Text="progress" Classes="muted" />
                                        <TextBlock Grid.Column="2" Text="{Binding ProgressEmptyText}" Classes="muted"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Blockers -->
                                    <Grid ColumnDefinitions="60,8,*">
                                        <TextBlock Grid.Column="0" Text="blockers" Classes="muted" />
                                        <Border Grid.Column="2" Classes="badge danger" HorizontalAlignment="Left"
                                                IsVisible="{Binding HasActiveBlockers}">
                                            <TextBlock Text="{Binding BlockerText}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding BlockerText}" Classes="muted"
                                                   IsVisible="{Binding !HasActiveBlockers}" />
                                    </Grid>

                                    <!-- Git -->
                                    <Grid ColumnDefinitions="60,8,*">
                                        <TextBlock Grid.Column="0" Text="git" Classes="muted" />
                                        <TextBlock Grid.Column="2" Text="{Binding GitText}" Classes="mono"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <!-- Latest build/test/launch verdicts -->
                                    <Grid ColumnDefinitions="60,8,*">
                                        <TextBlock Grid.Column="0" Text="results" Classes="muted" />
                                        <WrapPanel Grid.Column="2">
                                            <TextBlock Text="{Binding BuildText, StringFormat='build {0}'}"
                                                       Margin="{StaticResource Space3Right}" VerticalAlignment="Center"
                                                       Foreground="{Binding BuildOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                            <TextBlock Text="{Binding TestText, StringFormat='test {0}'}"
                                                       Margin="{StaticResource Space3Right}" VerticalAlignment="Center"
                                                       Foreground="{Binding TestOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                            <TextBlock Text="{Binding LaunchText, StringFormat='run {0}'}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding LaunchOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                        </WrapPanel>
                                    </Grid>

                                    <!-- Runtime health -->
                                    <Grid ColumnDefinitions="60,8,*">
                                        <TextBlock Grid.Column="0" Text="runtime" Classes="muted" />
                                        <TextBlock Grid.Column="2" Text="{Binding RuntimeHealthText}"
                                                   Foreground="{Binding RuntimeHealth, Converter={x:Static conv:HealthToBrushConverter.Instance}}" />
                                    </Grid>

                                    <!-- Footer: repo path, last activity, primary action -->
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="command"
                                                Content="{Binding PrimaryActionText}"
                                                Command="{Binding PrimaryCommand}"
                                                ToolTip.Tip="{Binding PrimaryActionTip}"
                                                AutomationProperties.Name="Primary project action" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RepositoryText}" Classes="muted mono"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding RepositoryText}" />
                                            <TextBlock Text="{Binding LastActivityText, StringFormat='last activity {0}'}"
                                                       Classes="muted" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
