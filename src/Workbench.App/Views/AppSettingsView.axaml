<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             x:Class="Workbench.App.Views.AppSettingsView"
             x:DataType="vm:AppSettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource Space6All}" Spacing="{StaticResource Space5}" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding GoBackCommand}" />
                <TextBlock Text="App Settings" Classes="h1" Margin="{StaticResource Space5Left}" VerticalAlignment="Center" />
            </DockPanel>

            <Border Classes="card">
                <StackPanel Spacing="{StaticResource Space3}">
                    <TextBlock Text="Appearance" Classes="h2" />
                    <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" Classes="muted"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding Theme}" Width="200" HorizontalAlignment="Left" />
                        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                  Content="Reduced motion (skip page and section transitions)"
                                  IsChecked="{Binding ReducedMotion}" />
                    </Grid>
                    <TextBlock Classes="muted" Text="Theme applies when you save settings." />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="{StaticResource Space3}">
                    <TextBlock Text="Project Discovery" Classes="h2" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="At startup (and via the dashboard's Rescan button), Workbench scans this folder — two levels deep — for directories that look like projects (a .git folder, a workbench.json, or a docker-compose file) and registers any it hasn't seen before. Repositories with a workbench.json are adopted as-is; the rest get sensible dotnet/docker defaults." />

                    <CheckBox Content="Discover projects automatically"
                              IsChecked="{Binding DiscoveryEnabled}" />
                    <TextBlock Text="Discovery Folder" Classes="muted" />
                    <TextBox Text="{Binding DiscoveryFolder}" Watermark="~/dev" />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="{StaticResource Space3}">
                    <TextBlock Text="Shared Workbench State" Classes="h2" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Point this at your Dropbox folder (default: ~/Dropbox/workbench). Dropbox syncs it between your PCs externally — Workbench never runs sync commands. Project configuration is shared as projects/*.workbench.json files. Local history, logs, and the database never leave this machine. Sync is always explicit — nothing runs in the background." />

                    <TextBlock Text="Shared State Folder" Classes="muted" />
                    <TextBox Text="{Binding SharedStateFolder}" Watermark="~/Dropbox/workbench" />
                    <TextBlock Text="{Binding SharedFolderSummary}" Classes="muted"
                               IsVisible="{Binding SharedFolderSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <TextBlock Text="Current Machine Name" Classes="muted" />
                    <TextBox Text="{Binding MachineName}" Watermark="detected automatically" />

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
                        <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" />
                        <Button Content="Open shared folder" Command="{Binding OpenSharedFolderCommand}" />
                        <Button Content="Reload shared state" Command="{Binding ReloadSharedStateCommand}" />
                        <Button Content="Import all projects" Command="{Binding ImportAllProjectsCommand}" />
                        <Button Content="Export all projects" Command="{Binding ExportAllProjectsCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Classes="muted"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding SettingsPath, StringFormat='Settings file: {0}'}" Classes="muted mono" />
                </StackPanel>
            </Border>

            <Border Classes="card"
                    IsVisible="{Binding ActivityLog.Count}">
                <StackPanel Spacing="{StaticResource Space2}">
                    <TextBlock Text="Result" Classes="h2" />
                    <ItemsControl ItemsSource="{Binding ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="{StaticResource Space0Vertical}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
