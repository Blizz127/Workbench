<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             xmlns:conv="using:Workbench.App.Converters"
             x:Class="Workbench.App.Views.RunView"
             x:DataType="vm:HistoryViewModel">

    <DockPanel Margin="{StaticResource Space3Top}">

        <!-- Launch profiles -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,12,*,12,*" Margin="{StaticResource Space5Bottom}">

            <!-- Build profile: full card when configured, compact tile otherwise -->
            <Border Grid.Column="0" Classes="card">
                <StackPanel Spacing="{StaticResource Space3}">
                    <TextBlock Text="Build" Classes="h2" />
                    <StackPanel Spacing="{StaticResource Space3}" IsVisible="{Binding HasBuildCommand}">
                        <Border Classes="output-panel">
                            <TextBlock Classes="mono" Text="{Binding BuildCommandText}"
                                       FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding LastBuildSummary}"
                                   Foreground="{Binding LastBuildOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                        <Button Content="Build" Classes="command.secondary" Command="{Binding RunBuildCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding !HasBuildCommand}">
                        <TextBlock Text="No build command configured." Classes="muted" TextWrapping="Wrap" />
                        <Button Content="Configure" Classes="command.ghost" HorizontalAlignment="Left"
                                Command="{Binding ConfigureCommandsCommand}"
                                AutomationProperties.Name="Configure build command" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Run profile (the star): the operations panel -->
            <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="{StaticResource Space3}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Classes="badge" Classes.info="{Binding IsRunning}"
                                VerticalAlignment="Center" AutomationProperties.Name="Run state">
                            <TextBlock Text="{Binding RunStateText}" />
                        </Border>
                        <TextBlock Text="Run" Classes="h2" />
                    </DockPanel>
                    <Border Classes="output-panel" IsVisible="{Binding HasRunCommand}">
                        <TextBlock Classes="mono" Text="{Binding RunCommandText}"
                                   FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Per-service lights; click a service to pull its logs -->
                    <ItemsControl ItemsSource="{Binding Services}" IsVisible="{Binding HasServices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceStateViewModel">
                                <Button Classes="command ghost" Command="{Binding ViewLogsCommand}"
                                        CommandParameter="{Binding Name}" ToolTip.Tip="View service logs"
                                        Margin="{StaticResource Space3Right}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="●"
                                                   Foreground="{Binding IsUp, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Live metric tiles (players, CPU, RAM, ...) -->
                    <ItemsControl ItemsSource="{Binding Metrics}" IsVisible="{Binding HasMetrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetricViewModel">
                                <StackPanel Margin="{StaticResource Space4Right}">
                                    <TextBlock Text="{Binding Label}" Classes="muted"
                                               FontSize="{StaticResource FontSizeSmall}" />
                                    <TextBlock Text="{Binding Value}" Classes="h2" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding GitInfoText}" Classes="mono muted"
                               FontSize="{StaticResource FontSizeSmall}" IsVisible="{Binding HasGitInfo}" />

                    <TextBlock Text="{Binding LastRunSummary}"
                               Foreground="{Binding LastRunOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding CommandResultText}" Classes="muted"
                               IsVisible="{Binding CommandResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding RuntimeHealthText}"
                               Foreground="{Binding CurrentHealth, Converter={x:Static conv:HealthToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding FailedComponentText}" Classes="muted"
                               IsVisible="{Binding HasFailedComponent}" />
                    <TextBlock Text="{Binding RunStatus}" Classes="muted"
                               IsVisible="{Binding RunStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- The one primary execution action -->
                    <WrapPanel IsVisible="{Binding HasRunCommand}">
                        <Button Content="▶ Start" Classes="command hero" Command="{Binding RunRunCommand}"
                                Margin="{StaticResource Space3Right}" AutomationProperties.Name="Start run" />
                        <Button Content="■ Stop" Classes="command danger" Command="{Binding StopCommand}"
                                Margin="{StaticResource Space3Right}" AutomationProperties.Name="Stop run" />
                        <Button Content="↻ Restart" Classes="command secondary" Command="{Binding RestartRunCommand}"
                                AutomationProperties.Name="Restart run" />
                    </WrapPanel>
                    <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding !HasRunCommand}">
                        <TextBlock Text="No run command configured." Classes="muted" TextWrapping="Wrap" />
                        <Button Content="Configure" Classes="command.ghost" HorizontalAlignment="Left"
                                Command="{Binding ConfigureCommandsCommand}"
                                AutomationProperties.Name="Configure run command" />
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="🧾 Logs" Classes="command secondary" Command="{Binding OpenLogsCommand}"
                                Margin="{StaticResource Space3Right}" AutomationProperties.Name="Open logs" />
                        <Button Content="⬆ Update" Classes="command secondary" Command="{Binding RunUpdateCommand}"
                                Margin="{StaticResource Space3Right}" AutomationProperties.Name="Run update" />
                        <Button Content="⌨ Shell" Classes="command secondary" Command="{Binding OpenShellCommand}"
                                AutomationProperties.Name="Open shell" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="♥ Recheck health" Classes="command secondary" Command="{Binding RecheckHealthCommand}"
                                Margin="{StaticResource Space3Right}" AutomationProperties.Name="Recheck health" />
                        <Button Content="🧾 Failed service logs" Classes="command secondary" Command="{Binding ViewFailedServiceLogsCommand}"
                                AutomationProperties.Name="View failed service logs" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Test profile: full card when configured, compact tile otherwise -->
            <Border Grid.Column="4" Classes="card">
                <StackPanel Spacing="{StaticResource Space3}">
                    <TextBlock Text="Test" Classes="h2" />
                    <StackPanel Spacing="{StaticResource Space3}" IsVisible="{Binding HasTestCommand}">
                        <Border Classes="output-panel">
                            <TextBlock Classes="mono" Text="{Binding TestCommandText}"
                                       FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding LastTestSummary}"
                                   Foreground="{Binding LastTestOutcome, Converter={x:Static conv:OutcomeToBrushConverter.Instance}}" />
                        <Button Content="Smoke test" Classes="command.secondary" Command="{Binding RunTestsCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding !HasTestCommand}">
                        <TextBlock Text="No test command configured." Classes="muted" TextWrapping="Wrap" />
                        <Button Content="Configure" Classes="command.ghost" HorizontalAlignment="Left"
                                Command="{Binding ConfigureCommandsCommand}"
                                AutomationProperties.Name="Configure test command" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Latest output: sanitized terminal-style panel with follow/copy/full-log actions -->
        <Border Classes="output-panel">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Space3Bottom}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Spacing="{StaticResource Space3}" VerticalAlignment="Center">
                        <Button Content="Follow" Classes="command.ghost" Classes.selected="{Binding FollowOutput}"
                                Command="{Binding ToggleFollowOutputCommand}"
                                ToolTip.Tip="Scroll to the end when output changes"
                                AutomationProperties.Name="Toggle output autoscroll" />
                        <Button Content="Copy" Classes="command.ghost" Click="OnCopyLog"
                                AutomationProperties.Name="Copy output" />
                        <Button Content="Open full log" Classes="command.ghost" Click="OnOpenFullLog"
                                AutomationProperties.Name="Open full log" />
                    </StackPanel>
                    <TextBlock Text="Latest output" Classes="section-header" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox x:Name="OutputBox" Text="{Binding SelectedLogText}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="160"
                         Classes="mono" FontSize="{StaticResource FontSizeSmall}" />
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
