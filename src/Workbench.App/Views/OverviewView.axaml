<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             xmlns:core="using:Workbench.Core.Models"
             x:Class="Workbench.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <ScrollViewer Margin="{StaticResource Space3Top}">
        <Grid ColumnDefinitions="*,12,*">

            <!-- Left column: focus + blockers -->
            <StackPanel Grid.Column="0" Spacing="{StaticResource Space5}">
                <Border Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="Focus" Classes="h2" />
                        <TextBlock Text="Current objective" Classes="muted" />
                        <TextBox Text="{Binding CurrentObjective}" Watermark="What is this project driving toward?" />
                        <TextBlock Text="Active task" Classes="muted" />
                        <TextBox Text="{Binding ActiveTask}" Watermark="What is being worked on right now?" />
                        <Button Content="Save" Classes="command.secondary" Command="{Binding SaveFocusCommand}"
                                HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="Blockers" Classes="h2" />
                        <TextBlock Text="Nothing is blocked." Classes="muted"
                                   IsVisible="{Binding !OpenBlockers.Count}" />
                        <ItemsControl ItemsSource="{Binding OpenBlockers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlockerItemViewModel">
                                    <Border Background="{DynamicResource DangerTintBrush}"
                                            CornerRadius="{StaticResource RadiusMedium}"
                                            Padding="{StaticResource Space3All}" Margin="{StaticResource Space1Vertical}">
                                        <StackPanel Spacing="{StaticResource Space1}">
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Since}" Classes="muted"
                                                       FontSize="{StaticResource FontSizeCaption}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Resolve"
                                                        Classes="command.secondary"
                                                        Command="{Binding ResolveCommand}" Margin="{StaticResource Space3Left}" />
                                                <TextBox Text="{Binding ResolutionText}" Watermark="How was it resolved?" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add" Classes="command.secondary"
                                    Command="{Binding AddBlockerCommand}" Margin="{StaticResource Space3Left}" />
                            <TextBox Text="{Binding NewBlockerText}" Watermark="Describe a new blocker" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right column: TODOs + recent notes -->
            <StackPanel Grid.Column="2" Spacing="{StaticResource Space5}">
                <Border Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="Open TODO items" Classes="h2" />
                        <TextBlock Text="No TODO comments found." Classes="muted"
                                   IsVisible="{Binding !Todos.Count}" />
                        <ItemsControl ItemsSource="{Binding Todos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:TodoItem">
                                    <StackPanel Margin="{StaticResource Space0Vertical}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                            <TextBlock Text="{Binding FilePath}" Classes="mono muted"
                                                       FontSize="{StaticResource FontSizeCaption}" />
                                            <TextBlock Text=":" Classes="muted" FontSize="{StaticResource FontSizeCaption}" />
                                            <TextBlock Text="{Binding LineNumber}" Classes="mono muted"
                                                       FontSize="{StaticResource FontSizeCaption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="{StaticResource Space2}">
                        <TextBlock Text="Recent notes" Classes="h2" />
                        <TextBlock Text="No notes yet." Classes="muted"
                                   IsVisible="{Binding !RecentNotes.Count}" />
                        <ItemsControl ItemsSource="{Binding RecentNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:Note">
                                    <DockPanel Margin="{StaticResource Space0Vertical}">
                                        <TextBlock DockPanel.Dock="Right" Classes="muted"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}" />
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
