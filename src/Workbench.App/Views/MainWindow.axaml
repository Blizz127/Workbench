<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Workbench.App.ViewModels"
        x:Class="Workbench.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Workbench"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="Auto,*">

        <!-- Left navigation rail -->
        <Border Grid.Column="0" Classes="rail" Width="{StaticResource RailWidth}">
            <StackPanel Spacing="{StaticResource Space1}">
                <TextBlock Text="WB" Classes="mono" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="{StaticResource Space2Bottom}"
                           AutomationProperties.Name="Workbench" />
                <Button Classes="nav-rail" Classes.selected="{Binding IsDashboardSelected}"
                        Command="{Binding NavigateHomeCommand}"
                        ToolTip.Tip="Dashboard" AutomationProperties.Name="Dashboard">
                    <StackPanel Spacing="{StaticResource Space0}">
                        <PathIcon Data="{StaticResource IconHome}"
                                  Width="{StaticResource IconSize}" Height="{StaticResource IconSize}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Home" FontSize="{StaticResource FontSizeMicro}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="nav-rail" Classes.selected="{Binding IsSettingsSelected}"
                        Command="{Binding NavigateSettingsCommand}"
                        ToolTip.Tip="App Settings" AutomationProperties.Name="App Settings">
                    <StackPanel Spacing="{StaticResource Space0}">
                        <PathIcon Data="{StaticResource IconGear}"
                                  Width="{StaticResource IconSize}" Height="{StaticResource IconSize}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="{StaticResource FontSizeMicro}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Top bar + main content + activity panel -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Top bar: global search chrome only. Project identity/state lives
                 in the workspace header (ProjectDetailView), not duplicated here. -->
            <Border Grid.Row="0" Classes="top-bar">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="{StaticResource Space2}" VerticalAlignment="Center">
                    <TextBox Width="{StaticResource SearchBoxWidth}"
                             Watermark="Search projects, notes, timeline, frontiers…"
                             Text="{Binding SearchText}"
                             AutomationProperties.Name="Global search">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding RunSearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="Search" Classes="command.ghost" Command="{Binding RunSearchCommand}" />
                    <Button Classes="command.ghost" Classes.selected="{Binding IsRightPanelVisible}"
                            Command="{Binding ToggleRightPanelCommand}"
                            ToolTip.Tip="Toggle activity panel"
                            AutomationProperties.Name="Toggle activity panel">
                        <PathIcon Data="{StaticResource IconPanel}"
                                  Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" />
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <!-- Current page (cross-fades on navigation; skipped under reduced motion) -->
                <TransitioningContentControl Grid.Column="0" Content="{Binding CurrentPage}"
                                             PageTransition="{Binding PageTransition}" />

                <!-- Collapsible activity panel -->
                <Border Grid.Column="1" Classes="activity-panel"
                        Width="{StaticResource ActivityPanelWidth}"
                        IsVisible="{Binding IsRightPanelVisible}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Recent activity" Classes="section-header" />
                        <Border Classes="empty-state" IsVisible="{Binding !HasProjectContext}">
                            <TextBlock Classes="empty-state"
                                       Text="Open a project to see its recent activity." />
                        </Border>
                        <ScrollViewer IsVisible="{Binding HasProjectContext}">
                            <ItemsControl ItemsSource="{Binding ActivityEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TimelineEntryViewModel">
                                        <StackPanel Margin="{StaticResource Space2Bottom}"
                                                    Spacing="{StaticResource Space0}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource Space2}">
                                                <TextBlock Text="{Binding Timestamp}" Classes="mono muted"
                                                           FontSize="{StaticResource FontSizeCaption}" />
                                                <Border Classes="badge">
                                                    <TextBlock Text="{Binding Category}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                       FontSize="{StaticResource FontSizeSmall}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Search results overlay (anchored to the top bar) -->
        <Border Grid.Column="1" IsVisible="{Binding IsSearchOpen}"
                Background="{DynamicResource OverlayBackgroundBrush}" BorderBrush="{DynamicResource OverlayBorderBrush}"
                BorderThickness="{StaticResource BorderThin}"
                CornerRadius="{StaticResource RadiusMedium}" Padding="{StaticResource Space4All}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="{StaticResource SearchOverlayMargin}"
                Width="{StaticResource SearchOverlayWidth}" MaxHeight="{StaticResource SearchOverlayMaxHeight}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Space3Bottom}">
                    <TextBlock Text="Search results" Classes="h2" />
                    <Button Content="✕" Command="{Binding CloseSearchCommand}"
                            HorizontalAlignment="Right" Padding="{StaticResource CompactButtonPadding}"
                            AutomationProperties.Name="Close search results" />
                </DockPanel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchHitViewModel">
                                <Button Command="{Binding OpenCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="{StaticResource Space0Vertical}" Padding="{StaticResource ListItemPadding}"
                                        Background="{DynamicResource NeutralTintBrush}">
                                    <StackPanel Spacing="{StaticResource Space0}">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding Domain}" FontSize="{StaticResource FontSizeCaption}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProjectName}" Classes="muted" />
                                        <TextBlock Text="{Binding Snippet}" Classes="muted"
                                                   TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
