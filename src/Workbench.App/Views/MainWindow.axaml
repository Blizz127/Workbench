<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Workbench.App.ViewModels"
        x:Class="Workbench.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Workbench"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <DockPanel>
            <!-- Header bar -->
            <Border DockPanel.Dock="Top" Background="#1B1F24" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Center">
                        <Button Content="⌂ Dashboard" Command="{Binding NavigateHomeCommand}" />
                        <TextBlock Text="WORKBENCH" Classes="h1" VerticalAlignment="Center"
                                   Foreground="#E8EDF2" />
                        <TextBlock Text="mission control" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox Width="320" Watermark="Search projects, notes, timeline, frontiers…"
                                 Text="{Binding SearchText}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding RunSearchCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Content="Search" Command="{Binding RunSearchCommand}" />
                        <Button Content="⚙ Settings" Command="{Binding NavigateSettingsCommand}" />
                    </StackPanel>
                    <Panel />
                </DockPanel>
            </Border>

            <!-- Current page -->
            <ContentControl Content="{Binding CurrentPage}" />
        </DockPanel>

        <!-- Search results overlay -->
        <Border IsVisible="{Binding IsSearchOpen}"
                Background="#F0161A1F" BorderBrush="#44FFFFFF" BorderThickness="1"
                CornerRadius="8" Padding="10"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,58,16,0" Width="520" MaxHeight="480">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Search results" Classes="h2" />
                    <Button Content="✕" Command="{Binding CloseSearchCommand}"
                            HorizontalAlignment="Right" Padding="6,2" />
                </DockPanel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchHitViewModel">
                                <Button Command="{Binding OpenCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,2" Padding="10,6"
                                        Background="#22FFFFFF">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding Domain}" FontSize="11" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProjectName}" Classes="muted" />
                                        <TextBlock Text="{Binding Snippet}" Classes="muted"
                                                   TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
