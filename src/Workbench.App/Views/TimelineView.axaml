<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.App.ViewModels"
             x:Class="Workbench.App.Views.TimelineView"
             x:DataType="vm:TimelineViewModel">

    <DockPanel Margin="0,8,0,0">
        <!-- Add entry row -->
        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                <ComboBox Grid.Column="0" Width="130"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding NewCategory}" />
                <TextBox Grid.Column="2" Text="{Binding NewMessage}"
                         Watermark="Journal what just happened — builds, breakthroughs, dead ends…">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddEntryCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="4" Content="Add entry" Command="{Binding AddEntryCommand}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimelineEntryViewModel">
                        <Border Classes="card" Margin="0,0,0,6" Padding="10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Timestamp}" Classes="mono muted" />
                                    <Border Classes="chip">
                                        <TextBlock Text="{Binding Category}" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Classes="mono muted" FontSize="11"
                                           TextWrapping="Wrap" MaxLines="6"
                                           IsVisible="{Binding HasDetail}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
