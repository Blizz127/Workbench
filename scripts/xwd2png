#!/usr/bin/env python3
"""Convert XWD (X Window Dump) file to PNG.  Reads from stdin or a file path,
writes PNG to stdout or the specified output path.  No dependencies beyond
Python stdlib (zlib, struct)."""

import struct
import sys
import zlib

def xwd_to_png(input_path: str | None, output_path: str | None) -> None:
    if input_path:
        data = open(input_path, 'rb').read()
    else:
        data = sys.stdin.buffer.read()

    # Parse XWD header (big-endian)
    header_size, version, pixmap_format, pixmap_depth, pixmap_width, pixmap_height, \
        xoffset, byte_order, bitmap_unit, bitmap_bit_order, bitmap_pad, bits_per_pixel, \
        bytes_per_line, visual_class, red_mask, green_mask, blue_mask, bits_per_rgb, \
        num_colors, color_map_entries, window_width, window_height, window_x, window_y, \
        window_border_width = struct.unpack_from(
        '>IIIIIIIIIIIIIIIIIIIIIIIII', data
    )

    if version != 7:
        raise ValueError(f"Unsupported XWD version: {version}")

    pixel_data = data[header_size:]

    width, height = pixmap_width, pixmap_height
    bpp = pixmap_depth  # bits per pixel

    if bpp == 24:
        # XWD 24-bit: BGRA (A is padding), we need RGB
        raw = bytearray()
        row_bytes = bytes_per_line
        for y in range(height):
            row_start = y * row_bytes
            for x in range(width):
                off = row_start + x * 4  # 4 bytes per pixel in XWD ZPixmap
                b = pixel_data[off]      # B
                g = pixel_data[off + 1]  # G
                r = pixel_data[off + 2]  # R
                raw.extend([r, g, b])
    elif bpp == 32:
        raw = bytearray()
        row_bytes = bytes_per_line
        for y in range(height):
            row_start = y * row_bytes
            for x in range(width):
                off = row_start + x * 4
                b = pixel_data[off]
                g = pixel_data[off + 1]
                r = pixel_data[off + 2]
                raw.extend([r, g, b])
    else:
        raise ValueError(f"Unsupported depth: {bpp}")

    # Build PNG
    def make_chunk(chunk_type: bytes, chunk_data: bytes) -> bytes:
        c = chunk_type + chunk_data
        crc = struct.pack('>I', zlib.crc32(c) & 0xFFFFFFFF)
        return struct.pack('>I', len(chunk_data)) + c + crc

    # IHDR
    ihdr = struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0)
    png = b'\x89PNG\r\n\x1a\n'
    png += make_chunk(b'IHDR', ihdr)

    # IDAT: filter byte 0 + RGB row
    filtered = bytearray()
    for y in range(height):
        filtered.append(0)  # filter None
        filtered.extend(raw[y * width * 3:(y + 1) * width * 3])
    compressed = zlib.compress(bytes(filtered))
    png += make_chunk(b'IDAT', compressed)

    # IEND
    png += make_chunk(b'IEND', b'')

    if output_path:
        with open(output_path, 'wb') as f:
            f.write(png)
    else:
        sys.stdout.buffer.write(png)


if __name__ == '__main__':
    import argparse
    p = argparse.ArgumentParser(description='Convert XWD to PNG')
    p.add_argument('input', nargs='?', help='Input XWD file (stdin if omitted)')
    p.add_argument('-o', '--output', help='Output PNG file (stdout if omitted)')
    args = p.parse_args()
    xwd_to_png(args.input, args.output)
